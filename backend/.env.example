# Copiar como referencia y definir estas variables en el entorno de ejecución
# (IntelliJ: Run Configuration > Environment variables; terminal: export/set).
# Spring Boot NO lee archivos .env automáticamente. Nunca subir un .env real a Git.

DB_URL=jdbc:mysql://localhost:3306/racemanager?serverTimezone=UTC
DB_USER=racemanager
DB_PASSWORD=CAMBIAR_EN_LOCAL

# Mínimo 32 caracteres aleatorios. Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRACION_MINUTOS=60

CORS_ORIGENES=http://localhost:5173
